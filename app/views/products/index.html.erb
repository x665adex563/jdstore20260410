<div class="grid grid-cols-2 gap-6 md:grid-cols-3 lg:grid-cols-4">
  <% @products.each do |product| %>
    <div class="overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-sm transition hover:-translate-y-1 hover:shadow-md">
      <%= link_to product_path(product), class: "block" do %>
        <% if product.image.attached? %>
          <%= image_tag product.image.variant(resize_to_limit: [400, 400]),
              class: "h-48 w-full object-cover" %>
        <% else %>
          <%= image_tag "https://placehold.co/400x400?text=No+Pic",
              class: "h-48 w-full object-cover" %>
        <% end %>
      <% end %>

      <div class="p-4">
        <h3 class="mb-2 text-sm font-semibold text-gray-900">
          <%= link_to product.title, product_path(product), class: "hover:text-blue-600" %>
        </h3>

        <p class="text-sm text-gray-600">
          ￥ <%= product.price %>
        </p>
      </div>
    </div>
  <% end %>
</div>
