<div class="container mx-auto px-4">
  <div class="mb-6 flex items-center justify-between">
    <h2 class="text-2xl font-bold">
      <%= t("carts.title") %>
    </h2>

    <%= button_to clear_carts_path,
        method: :delete,
        data: { turbo_confirm: t("carts.confirm_clear") },
        class: "inline-flex items-center rounded-lg border border-red-300 bg-white px-4 py-2 text-sm font-medium text-red-600 hover:bg-red-50 transition" do %>
      <i class="fa-solid fa-trash mr-2"></i>
      <%= t("carts.clear") %>
    <% end %>
  </div>

  <div class="overflow-x-auto">
    <table class="min-w-full border border-gray-200">
      <thead class="bg-gray-100">
        <tr>
          <th colspan="2" class="px-4 py-2 border-b border-gray-200 text-left">
            <%= t("carts.table.product_info") %>
          </th>
          <th class="px-4 py-2 border-b border-gray-200 text-right">
            <%= t("carts.table.price") %>
          </th>
          <th class="px-4 py-2 border-b border-gray-200 text-center">
            <%= t("carts.table.quantity") %>
          </th>
          <th class="px-4 py-2 border-b border-gray-200 text-center">
            <%= t("carts.table.actions") %>
          </th>
        </tr>
      </thead>

      <tbody>
        <% current_cart.cart_items.each do |cart_item| %>
          <tr class="hover:bg-gray-50">
            <td class="px-4 py-2 border-b border-gray-200 align-middle">
              <%= link_to product_path(cart_item.product) do %>
                <% if cart_item.product.image.attached? %>
                  <%= image_tag(cart_item.product.image, class: "h-20 w-20 rounded object-cover") %>
                <% else %>
                  <%= image_tag("https://placehold.co/200x200?text=No+Pic", class: "h-20 w-20 rounded object-cover") %>
                <% end %>
              <% end %>
            </td>

            <td class="px-4 py-2 border-b border-gray-200 align-middle">
              <%= link_to cart_item.product.title,
                  product_path(cart_item.product),
                  class: "text-blue-600 hover:underline" %>
            </td>

            <td class="px-4 py-2 border-b border-gray-200 text-right align-middle">
              <%= number_to_currency(cart_item.product.price, unit: "NT$") %>
            </td>

            <td class="px-4 py-2 border-b border-gray-200 text-center align-middle">
              <%= form_with model: cart_item,
                  url: cart_item_path(cart_item),
                  method: :patch,
                  local: true,
                  class: "flex justify-center items-center" do |f| %>

                <%= f.select :quantity,
                    (1..cart_item.product.quantity),
                    {},
                    class: "border border-gray-300 rounded px-2 py-1 focus:ring-2 focus:ring-blue-400",
                    onchange: "this.form.submit()",
                    disabled: cart_item.product.quantity.zero? %>

              <% end %>
            </td>

            <td class="px-4 py-2 border-b border-gray-200 text-center align-middle">
              <%= button_to cart_item_path(cart_item),
                  method: :delete,
                  data: { turbo_confirm: t("cart_items.confirm_remove") },
                  class: "inline-flex items-center justify-center text-red-500 hover:text-red-700 transition" do %>
                <i class="fa-solid fa-trash"></i>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <div class="mt-6 flex justify-end text-lg font-semibold">
    <%= t("carts.total") %> <span class="ml-2 text-red-600"><%= render_cart_total_price(current_cart) %> <%= t("currency.unit") %></span>
  </div>

  <hr class="my-6">

  <div class="flex justify-end">
    <%= button_to t("carts.checkout"), checkout_carts_path, method: :post, class: "bg-red-500 hover:bg-red-600 text-white font-bold py-3 px-6 rounded-lg transition-colors duration-200" %>
  </div>
</div>
